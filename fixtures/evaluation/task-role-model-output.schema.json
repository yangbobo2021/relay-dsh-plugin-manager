{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["plans"],
  "properties": {
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "locale", "roles", "ambiguities"],
        "properties": {
          "scenario_id": { "type": "string" },
          "locale": { "type": "string", "enum": ["zh-CN", "en"] },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "query", "required"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "query": { "type": "string" },
                "required": { "type": "boolean" }
              }
            }
          },
          "ambiguities": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "question", "options"],
              "properties": {
                "id": { "type": "string" },
                "question": { "type": "string" },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 8,
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
